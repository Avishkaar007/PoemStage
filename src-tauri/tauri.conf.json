{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poem Stage",
  "version": "1.0.0",
  "identifier": "com.yourname.poemstage",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Poem Stage",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "backgroundColor": "#06070a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "nsis", "deb"],
    "icon": ["icons/icon.png"]
  }
}
